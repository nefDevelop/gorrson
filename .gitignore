# Binary files
rss-cli
rss-cli.exe
/seed

# Database files (user data belongs to the user, not the repo)
data/*.db
data/*.db-journal
data/*.db-shm
data/*.db-wal
# El dataset de rendimiento vive en data/perf/ (dos niveles, así que data/*.db no
# lo cubre) y llega a 1,1 GiB con SEED_N=1000000: nunca debe acabar en un commit.
data/perf/

# Artefactos de benchmark comparativos (el baseline SÍ se commitea)
bench/current.txt
bench/current.stat

# Cache de imagenes. El servidor la regenera sola al sincronizar los feeds, asi
# que subirla solo infla el repo: son ficheros con nombre hash, uno por imagen.
# Cubre también la caché de la demo (make demo usa data/demo/).
data/cache/
data/demo/

# Test data and temporary files
test_data/
test_rss_data/
# cmd/root_test.go: TestCLI_Flow crea ./test_cli_data y no lo borra si el proceso
# muere por os.Exit (pasa cuando un feed externo responde 4xx/5xx).
cmd/test_cli_data/
coverage.out

# Go related
vendor/


# OS and IDE files
.DS_Store
.idea/
.vscode/
*.swp
*.log

# Node.js & Svelte related
node_modules/
dist/
.env
.svelte-kit/

# Binarios de test generados por `go test -c`
*.test
