# Gorrson Environment Configuration

# Port where the server will listen
GORRSON_PORT=7077

# Directory for storing user databases
GORRSON_DATA_DIR=./data

# JWT Secret Key for authentication. 
# CHANGE THIS to a long, random string for production!
GORRSON_JWT_SECRET=replace-this-with-a-random-string-at-least-32-chars-long
