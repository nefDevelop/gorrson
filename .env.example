# Copia a .env y rellena. El .env NUNCA se sube a Git.
# Puerto publicado en el host (dentro del contenedor siempre 7077).
GORRSON_PORT_HOST=7077

# OBLIGATORIO: secreto de firma JWT (>=32 caracteres). Sin él compose aborta.
# Genera uno con: openssl rand -base64 32
GORRSON_JWT_SECRET=cambia-este-secreto-largo-y-aleatorio-de-mas-de-32-caracteres
